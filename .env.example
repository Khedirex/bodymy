# =====================================================================
# BodyMy — variáveis de ambiente
# Copie para `.env.local` e preencha. NUNCA versione o .env.local.
# =====================================================================

# --- Supabase -------------------------------------------------------
# URL do projeto e chave anônima (públicas — usadas no browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service_role — PODER TOTAL sobre o banco (ignora RLS).
# USAR SOMENTE EM CÓDIGO DE SERVIDOR (rotas de API / server actions).
# NUNCA prefixar com NEXT_PUBLIC_ e NUNCA importar no client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (e-mails transacionais) ---------------------------------
RESEND_API_KEY=
# Remetente. Formato OBRIGATÓRIO: "Nome <email@dominio>".
# - Produção: use um e-mail de um DOMÍNIO VERIFICADO no Resend
#   (ex: "BodyMy <ola@seudominio.com>").
# - Dev/sem domínio verificado: DEIXE VAZIO. O código cai no remetente de
#   teste do Resend ("onboarding@resend.dev"), que entrega SEM verificar
#   domínio — porém SÓ para o e-mail dono da conta Resend.
RESEND_FROM=

# --- Kiwify (webhook de compra) -------------------------------------
# Segredo usado para validar a assinatura do webhook.
KIWIFY_WEBHOOK_SECRET=

# --- Hotmart (webhook de compra) ------------------------------------
# "hottok" do webhook da Hotmart (Ferramentas → Webhook). Validado contra
# o header X-HOTMART-HOTTOK / corpo em /api/webhooks/hotmart.
HOTMART_WEBHOOK_TOKEN=

# --- Nutricionista Online (chat de IA via n8n) ----------------------
# Base dos webhooks do n8n (ex.: https://SEU.app.n8n.cloud/webhook). O app
# chama {N8N_BASE_URL}/gerar-dieta e {N8N_BASE_URL}/chat.
N8N_BASE_URL=
# Chave enviada como "Authorization: Bearer <chave>" nas chamadas ao n8n.
# Configure o mesmo valor no nó de autenticação dos webhooks do n8n.
N8N_API_KEY=

# --- Panda Video (player das aulas) ---------------------------------
PANDA_API_KEY=
# Subdomínio/host do player do Panda usado no embed do iframe.
NEXT_PUBLIC_PANDA_PLAYER_HOST=player-vz-abc123.tv.pandavideo.com.br

# --- PostHog (analytics de produto) ---------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry (monitoramento de erros) --------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Meta Pixel -----------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=

# --- App ------------------------------------------------------------
# Domínio público do app. Em produção: https://app.bodymy.online
# (usado para montar os links de acesso/magic-link nos e-mails).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Habilita a rota /api/dev/simulate-purchase (SOMENTE em dev/staging).
DEV_TOOLS_ENABLED=true
